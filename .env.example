# =====================================================================
# Reference template — variable names ONLY, no values.
# Copy to `.env.dev` (development) or `.env.prod` (production, secrets).
# Both are gitignored: put your real values there, never here.
# Defaults live in `config/settings.py` (empty value = default).
# Select the env file at runtime: ENV_FILE=.env.prod docker compose --env-file .env.prod up -d
# =====================================================================

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=

# PostgreSQL (db service in docker-compose)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Public base URL of the backend (used to build the verification link)
APP_BASE_URL=

# JWT lifetimes
JWT_ACCESS_HOURS=
JWT_REFRESH_DAYS=

# Demo payment adapters (true = local stand-ins, no real BitLibera/Blink needed)
# Set to False once Backend Dev B's real adapters are registered.
FOBOS_USE_DEMO_ADAPTERS=

# Email verification link lifetime (seconds, default 86400 = 24h)
EMAIL_VERIFICATION_MAX_AGE_SECONDS=

# Email — console backend by default, switch to SMTP for real delivery
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=