# =====================================================================
# Reference template — copy to `.env.dev` (development) or `.env.prod`
# (production, secrets — gitignored). Never edit real secrets in this file.
# Select the env file at runtime: ENV_FILE=.env.prod docker compose --env-file .env.prod up -d
# =====================================================================

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (db service in docker-compose)
POSTGRES_DB=fobos
POSTGRES_USER=fobos
POSTGRES_PASSWORD=fobos
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Public base URL of the backend (used to build the verification link)
APP_BASE_URL=http://localhost:8000

# JWT lifetimes
JWT_ACCESS_HOURS=4
JWT_REFRESH_DAYS=7

# Demo payment adapters (true = local stand-ins, no real BitLibera/Blink needed)
# Set to False once Backend Dev B's real adapters are registered.
FOBOS_USE_DEMO_ADAPTERS=true

# Email verification link lifetime (seconds, default 86400 = 24h)
EMAIL_VERIFICATION_MAX_AGE_SECONDS=86400

# Email — console backend by default, switch to SMTP for real delivery
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=fobos@example.com