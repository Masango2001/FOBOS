# =====================================================================
# Reference template — variable names ONLY, no values.
# Copy to `.env.dev` (development) or `.env.prod` (production, secrets).
# Both are gitignored: put your real values there, never here.
# Defaults live in `config/settings.py` (empty value = default).
# Select the env file at runtime: ENV_FILE=.env.prod docker compose --env-file .env.prod up -d
# =====================================================================

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=

# PostgreSQL (db service in docker-compose)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Public base URL of the backend (used to build the verification link)
APP_BASE_URL=

# JWT lifetimes
JWT_ACCESS_HOURS=
JWT_REFRESH_DAYS=

# Payment adapters: use demo for local simulation or live for provider requests.
FOBOS_USE_DEMO_ADAPTERS=
FOBOS_USE_LIVE_ADAPTERS=
BITLIBERA_API_URL=
BITLIBERA_API_KEY=
BLINK_API_URL=

# Frontend origins allowed to call the API in production (comma-separated).
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=false
MEDIA_ROOT=

# --- Provider credentials (doc §18, §47) ---
# Blink — Lightning rail (GraphQL). BLINK_USERNAME identifies the company
# Blink account; BTC/USD wallet ids identify the wallets FOBOS uses. None of
# these is a Lightning receiving address by itself.
BLINK_API_URL=
BLINK_API_KEY=
BLINK_USERNAME=
BLINK_BTC_WALLET_ID=
BLINK_USD_WALLET_ID=
# Optional, per final contract: company Lightning Address (user@blink.sv).
BLINK_LIGHTNING_ADDRESS=
# WebSocket endpoint for Blink status subscriptions (doc §52).
BLINK_WSS_URL=

# BitLibera — BIF/Lumicash gateway (REST).
BITLIBERA_BASE_URL=
BITLIBERA_MERCHANT_ID=
BITLIBERA_API_KEY=

# Fixed company Lumicash number, when the provider contract requires it (doc §47).
LUMICASH_PHONE=

# Email verification link lifetime (seconds, default 86400 = 24h)
EMAIL_VERIFICATION_MAX_AGE_SECONDS=

# Email — console backend by default, switch to SMTP for real delivery
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=
